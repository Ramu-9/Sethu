# 1. Application URL
APP_URL=http://localhost:3000

# 2. Google Gemini API (Server-Side Reasoning Engine)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-3.8-flash
GEMINI_GATE_0_3_VERIFIED=true

# 3. Gnani Prisma v2.5 Speech-to-Text (WSS 16 kHz Mono PCM Streaming)
PRISMA_ENDPOINT_URL=wss://api.vachana.ai/stt/v3/stream
PRISMA_AUTH_TOKEN=your_vachana_prisma_token_here
PRISMA_GATE_0_1_VERIFIED=true

# 4. Gnani Timbre v2.5 Text-to-Speech (SSE 16 kHz Mono PCM Streaming)
TIMBRE_ENDPOINT_URL=https://api.vachana.ai/api/v1/tts/sse
TIMBRE_AUTH_TOKEN=your_vachana_timbre_token_here
TIMBRE_GATE_0_2_VERIFIED=true

# 5. PostgreSQL (Neon / PostGIS + pg_trgm)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/setu?sslmode=require
MIGRATION_DATABASE_URL=postgresql://user:password@host:5432/setu?sslmode=require

# 6. Session Signing Secret (256-bit HMAC-SHA256)
SETU_SESSION_TOKEN_SECRET=replace_with_64_hex_char_hmac_sha256_secret

# 7. Deterministic Hospital Scoring Weights (Sum = 1.0)
HOSPITAL_WEIGHT_DISTANCE=0.625
HOSPITAL_WEIGHT_CAPABILITY=0.375
HOSPITAL_WEIGHT_ETA=0.0

# 8. Caller Silence Timeout Policy
TIMEOUT_INITIAL_SILENCE_SECONDS=16
TIMEOUT_MAX_CHECK_INS=2
TIMEOUT_WAIT_BETWEEN_CHECK_INS_SECONDS=6
TIMEOUT_MAX_IDLE_EXHAUSTION_SECONDS=50