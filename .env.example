# GEMINI_API_KEY: Required for server-side Google Gemini API calls (Gate 0.3).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL_ID="gemini-3.8-flash"
GEMINI_GATE_0_3_VERIFIED="false"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Gnani Prisma v2.5 Speech-to-Text Configuration (Gate 0.1)
PRISMA_ENDPOINT_URL=""
PRISMA_AUTH_TOKEN=""
PRISMA_GATE_0_1_VERIFIED="false"

# Gnani Timbre v2.5 Text-to-Speech Configuration (Gate 0.2)
TIMBRE_ENDPOINT_URL=""
TIMBRE_AUTH_TOKEN=""
TIMBRE_GATE_0_2_VERIFIED="false"

# PostgreSQL 16 + PostGIS + pg_trgm Connection Strings (Sections 6 & 21.2)
DATABASE_URL="postgresql+asyncpg://setu_runtime:setu_runtime@localhost:5432/setu"
MIGRATION_DATABASE_URL="postgresql+asyncpg://setu_owner:setu_owner_dev_password@localhost:5432/setu"

# Session Reconnection HMAC-SHA256 Signing Secret (Section 8.4)
SETU_SESSION_TOKEN_SECRET="replace-with-strong-hmac-secret-in-production"

# Configurable Hospital Directory Scoring Weights — Must Sum to 1.0 (Section 13.2)
HOSPITAL_WEIGHT_DISTANCE="0.45"
HOSPITAL_WEIGHT_CAPABILITY="0.35"
HOSPITAL_WEIGHT_ETA="0.20"

# Configurable Caller Silence Timeout Policy Parameters (Rule 5 & Section 19)
TIMEOUT_INITIAL_SILENCE_SECONDS="15.0"
TIMEOUT_MAX_CHECK_INS="2"
TIMEOUT_WAIT_BETWEEN_CHECK_INS_SECONDS="15.0"
TIMEOUT_MAX_IDLE_EXHAUSTION_SECONDS="90.0"
